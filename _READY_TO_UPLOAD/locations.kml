      <name>คลังสินค้า</name>
      <Placemark>
        <name>สำนักงานขายโฮมเพลส</name>
        <description><![CDATA[283/50 อาคารโฮมเพลสออฟฟิศบิลดิ้ง<br>ชั้น 11 ซอยสุขุมวิท 55 (ทองหล่อ 13)<br>ถนนสุขุมวิท แขวงคลองตันเหนือ<br>เขตวัฒนา กรุงเทพฯ 10110<br><br>https://goo.gl/maps/XjN3KuurkwPgqxtK9]]></description>
        <styleUrl>#icon-1603-FF5252</styleUrl>
        <Point>
          <coordinates>
            100.581833940427,13.73400500824,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>สำนักงานบัญชียิ่งโอฬาร</name>
        <description><![CDATA[244/365 ซ.วิภาวดีรังสิต 43 ถนนวิภาวดีรังสิต แขวงสนามบิน เขตดอนเมือง กทม.10210<br><br>https://goo.gl/maps/4awA2AiKYtS5TRZA9]]></description>
        <styleUrl>#icon-1603-E65100</styleUrl>
        <Point>
          <coordinates>
            100.614920839448,13.9454145125278,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>หจก. มิลด์โก้ เทรดดิ้ง สำนักงานใหญ่</name>
        <description><![CDATA[7/24 ซอยสุวรรณสวัสดิ์ ถนนพระราม 4 แขวงทุ่งมหาเมฆ เขตสาทร กรุงเทพมหานคร 10120<br>13.72308, 100.55003<br>https://maps.app.goo.gl/gMAhYDrgxRuvUdqm9]]></description>
        <styleUrl>#icon-1603-F9A825</styleUrl>
        <Point>
          <coordinates>
            100.550036,13.7230811,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>สาขาบางพลี</name>
        <description><![CDATA[9/18 หมู่ที่ 3 ถ.บางนา-ตราด กม.23 (ขาเข้า)<br>ต.บางเสาธง อ.บางเสาธง จ.สมุทรปราการ 10540<br>https://goo.gl/maps/YvigfZviSUDuk6LK8]]></description>
        <styleUrl>#icon-1859-3949AB</styleUrl>
        <Point>
          <coordinates>
            100.802579,13.593818,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>สาขาสุขุมวิท 50</name>
        <description><![CDATA[2026 ถนนริมทางรถไฟสายปากน้ำ แขวงพระโขนง เขตวัฒนา กรุงเทพมหานคร 10110<br><br>https://goo.gl/maps/8soDtaBfUcmYaZ7R8]]></description>
        <styleUrl>#icon-1859-3949AB</styleUrl>
        <Point>
          <coordinates>
            100.58795718026,13.6994906324725,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>สาขารามอินทรา</name>
        <description><![CDATA[เลขที่ 450/5 ซอย เจริญพัฒนา 17 แขวง บางชัน เขตคลองสามวา กรุงเทพมหานคร 10510<br><br>https://goo.gl/maps/ic2tbo97EQ3khDqy6]]></description>
